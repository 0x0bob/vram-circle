{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci && npm ci --prefix app",
  "buildCommand": "node scripts/build-arc-testnet.mjs",
  "outputDirectory": "app/dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/screen.ts": {
      "maxDuration": 60
    }
  }
}
