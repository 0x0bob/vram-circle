# Placeholders only. Never commit real values.
# NEVER put a private key in this file or any env var. Deploy with a Foundry encrypted keystore:
#   cast wallet import vram-deployer --interactive
#   forge script ... --account vram-deployer
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io   # public RPC, no key (source: docs.arc.io)
# Arc testnet USDC is pinned in script/Deploy.s.sol (0x3600...0000, 6 decimals); USDC_ADDRESS is for the local chain only.
USDC_ADDRESS=
TREASURY=          # testnet: a plain wallet you control. Mainnet: a real multisig (CLAUDE.md section 11).
GUARDIAN=          # testnet: a different plain wallet. Mainnet: a real multisig. Must differ from TREASURY.
