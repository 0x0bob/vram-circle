# Placeholders only. Never commit real values.
# NEVER put a private key in this file or any env var. Deploy with a Foundry encrypted keystore:
#   cast wallet import vram-deployer --interactive
#   forge script ... --account vram-deployer
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io   # public RPC, no key (source: docs.arc.io)
# Arc testnet USDC is pinned in script/Deploy.s.sol (0x3600...0000, 6 decimals); USDC_ADDRESS is for the local chain only.
USDC_ADDRESS=
TREASURY=          # testnet: a plain wallet you control. Mainnet: a real multisig (CLAUDE.md section 11).
GUARDIAN=          # testnet: a different plain wallet. Mainnet: a real multisig. Must differ from TREASURY.

# --- Vercel project environment variables (server side; set them in the Vercel dashboard, never in a file) ---
# BLOB_READ_WRITE_TOKEN=     created when you create a Blob store and connect it to the project
# ANTHROPIC_API_KEY=         optional: turns on AI scoring in the quality agent (without it, non-AI checks only)
# AGENT_MODEL=claude-haiku-5-5        TODO(verify) against the current Claude API docs
# AGENT_DAILY_CAP_USD=2
# AGENT_DAILY_MAX_CALLS=200
# ARC_RPC_URL=               optional server-side RPC (may contain a provider key)
# VITE_RPC_URL=              optional browser RPC, baked into the bundle: use a key restricted to our domain
